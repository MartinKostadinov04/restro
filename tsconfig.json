{
  // Type checks the repo-level files that belong to no package: the Vitest config and scripts/.
  // Packages and apps have their own tsconfig.json and are checked by `pnpm -r typecheck`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    // vitest.config.ts and the Node-run scripts (pnpm vendor-words:baseline) import their helpers
    // with explicit ".ts" extensions: Vite's native config loader and Node's built-in TypeScript
    // support both need them, and only erasable syntax works under Node.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["vitest.config.ts", "scripts"]
}
