/* The page: the venue's variables, the light set by default. */
.rm {
  --rm-pill: calc(var(--rm-radius) * 1.6);
  --rm-bg: var(--rm-l-background);
  --rm-surface: var(--rm-l-surface);
  --rm-accent: var(--rm-l-accent);
  --rm-on-accent: var(--rm-l-onAccent);
  --rm-text: var(--rm-l-text);
  --rm-muted: var(--rm-l-muted);
  --rm-accent-text: var(--rm-l-accentText);
  --rm-border: var(--rm-l-border);
  min-height: 100vh;
  background: var(--rm-bg);
  color: var(--rm-text);
  font-family: var(--rm-font);
  font-size: 16px;
  line-height: 1.45;
  letter-spacing: 0;
}
.rm * {
  box-sizing: border-box;
}
.rm [hidden] {
  display: none !important;
}
.rm button {
  font: inherit;
  color: inherit;
  cursor: pointer;
}
.rm button:focus-visible,
.rm a:focus-visible {
  outline: 3px solid var(--rm-accent-text);
  outline-offset: 3px;
}
.rm svg {
  width: 24px;
  height: 24px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
}
.rm-sr {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
/* The venue bar and the title block. */
.rm-header {
  padding: 18px 20px 24px;
  background: var(--rm-text);
  color: var(--rm-bg);
}
.rm-brandline {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 10px;
  align-items: center;
}
.rm-logo {
  display: block;
  max-width: 96px;
  max-height: 44px;
  object-fit: contain;
}
.rm-headtools {
  grid-column: 2;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 2px 6px;
  min-width: 0;
}
.rm-table {
  border: 1px solid color-mix(in srgb, var(--rm-bg) 24%, transparent);
  border-radius: 999px;
  padding: 7px 10px;
  font-size: 11px;
}
.rm-icon,
.rm-overlay-head button {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 0;
  background: transparent;
  color: inherit;
}
.rm-titleblock {
  padding-top: 26px;
  max-width: 560px;
}
.rm-titleblock h1 {
  margin: 0;
  font-size: clamp(38px, 11vw, 60px);
  line-height: 0.95;
  font-weight: 880;
  overflow-wrap: anywhere;
}
.rm-titleblock > p {
  margin: 12px 0 0;
  max-width: 40ch;
  color: color-mix(in srgb, var(--rm-bg) 72%, transparent);
}
.rm-titleblock .rm-schedule {
  color: var(--rm-bg);
  font-weight: 750;
}
/* The category rail. */
.rm-sections {
  position: sticky;
  z-index: 10;
  top: 0;
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 0 12px;
  background: color-mix(in srgb, var(--rm-bg) 96%, transparent);
  border-bottom: 1px solid var(--rm-border);
  scrollbar-width: none;
  overscroll-behavior-x: contain;
}
.rm-sections::-webkit-scrollbar,
.rm-section.is-feature .rm-items::-webkit-scrollbar {
  display: none;
}
.rm-sections a {
  position: relative;
  flex: none;
  min-width: 44px;
  min-height: 56px;
  padding: 0 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--rm-muted);
  font-size: 13px;
  font-weight: 800;
  text-decoration: none;
  white-space: nowrap;
}
.rm-sections a:after {
  content: "";
  position: absolute;
  right: 8px;
  bottom: 0;
  left: 8px;
  height: 3px;
  background: var(--rm-accent-text);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.2s ease;
}
.rm-sections a[aria-current="true"] {
  color: var(--rm-text);
}
.rm-sections a[aria-current="true"]:after {
  transform: scaleX(1);
}
/* Sections and their items. */
.rm-section {
  padding: 58px 20px 0;
  scroll-margin-top: 56px;
}
.rm-section-head {
  margin-bottom: 22px;
}
.rm-section-head > img {
  width: 100%;
  aspect-ratio: 16 / 7;
  object-fit: cover;
  border-radius: var(--rm-radius);
  margin-bottom: 24px;
}
.rm-section h2,
.rm-section h3,
.rm-section h4 {
  margin: 0;
  font-size: 31px;
  line-height: 1.02;
  font-weight: 880;
  overflow-wrap: anywhere;
}
.rm-section-head p {
  max-width: 42ch;
  margin: 12px 0 0;
  color: var(--rm-muted);
}
.rm-items {
  display: grid;
  gap: 0;
}
.rm-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 116px;
  gap: 18px;
  padding: 25px 0;
  border-top: 1px solid var(--rm-border);
  content-visibility: auto;
  contain-intrinsic-size: 210px;
}
/* A sold-out or unavailable item is greyed: its photo fades, and its name and price take the muted
   colour. The state label, the allergens and the labels stay at full strength: they say why and
   what is in it, and a text faded to half would not read (the whole card used to fade to 52 %). */
.rm-item[data-state="sold_out"] .rm-photo,
.rm-item[data-state="unavailable"] .rm-photo {
  opacity: 0.52;
}
.rm-item[data-state="sold_out"] .rm-item-open,
.rm-item[data-state="sold_out"] .rm-price,
.rm-item[data-state="unavailable"] .rm-item-open,
.rm-item[data-state="unavailable"] .rm-price {
  color: var(--rm-muted);
}
.rm-photo {
  grid-column: 2;
  grid-row: 1;
  position: relative;
}
.rm-photo img {
  display: block;
  width: 116px;
  height: 116px;
  object-fit: cover;
  border-radius: calc(var(--rm-radius) * 0.8);
  background: var(--rm-surface);
}
/* Badges: one slot with all of an item's badges, over the photo's corner or above a text row. */
.rm-badges {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
}
.rm-photo .rm-badges {
  position: absolute;
  top: 8px;
  left: 8px;
  max-width: calc(100% - 16px);
}
.rm-badge {
  padding: 5px 8px;
  border-radius: 999px;
  background: var(--rm-accent);
  color: var(--rm-on-accent);
  font-size: 10px;
  font-weight: 850;
  box-shadow: 0 3px 10px color-mix(in srgb, var(--rm-text) 14%, transparent);
}
.rm-item-copy {
  grid-column: 1;
  grid-row: 1;
  min-width: 0;
}
.rm-item-open {
  display: block;
  width: 100%;
  min-height: 44px;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: left;
}
.rm-item :is(h3, h4) {
  font-size: 19px;
  line-height: 1.12;
  font-weight: 850;
}
.rm-price {
  margin-top: 7px;
  font-size: 14px;
  font-weight: 850;
}
.rm-state {
  min-height: 0;
  margin-top: 7px;
  color: var(--rm-accent-text);
  font-size: 13px;
  font-weight: 800;
}
.rm-state:empty {
  display: none;
}
.rm-description {
  margin-top: 9px;
  color: var(--rm-muted);
  font-size: 14px;
}
.rm-description p {
  margin: 0;
}
.rm-description p[data-clamped="true"] {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.rm-portion {
  margin-top: 7px;
  color: var(--rm-muted);
  font-size: 12px;
}
.rm-labels {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 11px;
}
.rm-labels span {
  padding: 5px 9px;
  border: 1px solid var(--rm-border);
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
}
.rm-allergens {
  margin-top: 8px;
}
.rm-allergens button {
  min-width: 44px;
  max-width: 100%;
  min-height: 44px;
  padding: 4px 0;
  border: 0;
  background: transparent;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px;
}
.rm-allergens b {
  display: grid;
  place-items: center;
  min-width: 30px;
  height: 30px;
  padding: 0 4px;
  border: 1px solid var(--rm-border);
  border-radius: 7px;
  font-size: 11px;
}
.rm-extra,
.rm-modifiers {
  margin-top: 10px;
  color: var(--rm-muted);
  font-size: 12px;
}
.rm-extra {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.rm-modifiers p {
  margin: 5px 0;
}
.rm-waiter {
  font-weight: 750;
}
/* The photo-led strip: a section marked horizontal (D92), big cards that scroll sideways. */
.rm-section.is-feature {
  padding-top: 38px;
}
.rm-section.is-feature .rm-items {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  margin: 0 -20px;
  padding: 0 20px 18px;
  scroll-snap-type: x mandatory;
  scroll-padding-inline: 20px;
  scrollbar-width: none;
}
.rm-section.is-feature .rm-item {
  display: block;
  flex: 0 0 84vw;
  width: 84vw;
  max-width: 390px;
  padding: 0 0 24px;
  border: 0;
  scroll-snap-align: start;
}
.rm-section.is-feature .rm-photo,
.rm-section.is-feature .rm-item-copy {
  display: block;
}
.rm-section.is-feature .rm-photo img {
  width: 100%;
  height: auto;
  aspect-ratio: 1.22 / 1;
  border-radius: calc(var(--rm-radius) * 1.15);
}
.rm-section.is-feature .rm-item-copy {
  padding-top: 17px;
}
.rm-section.is-feature .rm-item :is(h3, h4) {
  font-size: 22px;
}
.rm-section.is-feature .rm-price {
  font-size: 15px;
}
/* The allergen information footer. */
.rm-footer {
  margin-top: 78px;
  padding: 42px 20px calc(42px + env(safe-area-inset-bottom));
  background: var(--rm-text);
  color: var(--rm-bg);
}
.rm-footer h2 {
  margin: 0;
  font-size: 25px;
}
.rm-footer > p {
  max-width: 46ch;
  color: color-mix(in srgb, var(--rm-bg) 70%, transparent);
}
.rm-legend {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 28px;
}
.rm-legend span,
.rm-allergen-sheet li {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 13px;
}
.rm-legend b,
.rm-allergen-sheet b {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border: 1px solid currentColor;
  border-radius: 7px;
}
/* Sheets (filters, allergens) and the dish page: one dialog, two looks. */
.rm-overlay {
  position: fixed;
  z-index: 50;
  inset: 0;
  background: color-mix(in srgb, var(--rm-text) 72%, transparent);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding-top: 8dvh;
}
.rm-overlay-panel {
  width: min(100%, 640px);
  max-height: 92dvh;
  overflow: auto;
  overscroll-behavior: contain;
  background: var(--rm-text);
  color: var(--rm-bg);
  padding: 0 20px 38px;
  border-radius: calc(var(--rm-radius) * 1.4) calc(var(--rm-radius) * 1.4) 0 0;
  box-shadow: 0 -18px 48px color-mix(in srgb, var(--rm-text) 25%, transparent);
}
.rm-overlay-panel.is-detail {
  position: relative;
  padding: 0;
  background: var(--rm-bg);
  color: var(--rm-text);
}
.rm-overlay-head {
  position: sticky;
  z-index: 3;
  top: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  min-height: 64px;
  background: inherit;
  border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  font-size: 12px;
  font-weight: 850;
  text-transform: uppercase;
}
.rm-overlay-panel.is-detail > .rm-overlay-head {
  position: absolute;
  right: 12px;
  left: 12px;
  background: transparent;
  border: 0;
  pointer-events: none;
}
.rm-overlay-panel.is-detail > .rm-overlay-head > span {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
.rm-overlay-panel.is-detail > .rm-overlay-head button {
  margin-left: auto;
  border-radius: 999px;
  background: var(--rm-bg);
  color: var(--rm-text);
  box-shadow: 0 4px 18px color-mix(in srgb, var(--rm-text) 22%, transparent);
  pointer-events: auto;
}
.rm-overlay-head > span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rm-overlay-intro {
  color: color-mix(in srgb, var(--rm-bg) 70%, transparent);
}
.rm-filter-group {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 28px 0 0;
  padding: 0;
  border: 0;
}
.rm-filter-group legend {
  width: 100%;
  margin-bottom: 8px;
  font-size: 20px;
  font-weight: 850;
}
.rm-filter-group button {
  min-width: 44px;
  min-height: 48px;
  padding: 0 17px;
  /* The edge of a choice shows at 3:1 on the panel (it was 30 %, about 1.9:1). */
  border: 1px solid color-mix(in srgb, var(--rm-bg) 52%, transparent);
  border-radius: var(--rm-pill);
  background: transparent;
}
.rm-filter-group button[aria-pressed="true"] {
  background: var(--rm-accent);
  color: var(--rm-on-accent);
  border-color: var(--rm-accent);
}
.rm-clear {
  min-width: 44px;
  min-height: 48px;
  margin-top: 30px;
  padding: 0;
  border: 0;
  background: transparent;
  text-decoration: underline;
}
.rm-allergen-sheet {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin: 26px 0 0;
  padding: 0;
  list-style: none;
}
.rm-allergen-sheet li {
  opacity: 0.72;
}
.rm-allergen-sheet li.is-present {
  opacity: 1;
  font-weight: 800;
}
.rm-allergen-sheet li.is-present b {
  background: var(--rm-bg);
  color: var(--rm-text);
}
.rm-detail-photo {
  overflow: hidden;
  background: var(--rm-surface);
}
.rm-detail-photo img {
  display: block;
  width: 100%;
  max-height: 52dvh;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}
.rm-detail-copy {
  padding: 30px 20px 52px;
}
.rm-detail-title {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16px;
  align-items: start;
}
.rm-detail-title h2 {
  margin: 0;
  font-size: 30px;
  line-height: 1.03;
  font-weight: 880;
  overflow-wrap: anywhere;
}
.rm-detail-title strong {
  font-size: 16px;
}
.rm-detail-copy > p {
  color: var(--rm-muted);
}
.rm-detail-state {
  color: var(--rm-accent-text) !important;
  font-weight: 800;
}
.rm-detail-allergens {
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid var(--rm-border);
}
.rm-detail-extra {
  margin: 8px 0;
}
.rm-detail-group {
  margin-top: 30px;
  padding-top: 22px;
  border-top: 1px solid var(--rm-border);
}
.rm-detail-group h3 {
  margin: 0 0 14px;
  font-size: 20px;
}
.rm-detail-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}
.rm-detail-option {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
  min-height: 58px;
  padding: 10px 13px;
  border: 1px solid var(--rm-border);
  border-radius: var(--rm-radius);
  font-size: 13px;
}
.rm-detail-option b:empty {
  display: none;
}
/* The dark set, forced (data-scheme="dark") or following the guest's screen (auto). */
.rm[data-scheme="dark"] {
  --rm-bg: var(--rm-d-background);
  --rm-surface: var(--rm-d-surface);
  --rm-accent: var(--rm-d-accent);
  --rm-on-accent: var(--rm-d-onAccent);
  --rm-text: var(--rm-d-text);
  --rm-muted: var(--rm-d-muted);
  --rm-accent-text: var(--rm-d-accentText);
  --rm-border: var(--rm-d-border);
}
@media (prefers-color-scheme: dark) {
  .rm[data-scheme="auto"] {
    --rm-bg: var(--rm-d-background);
    --rm-surface: var(--rm-d-surface);
    --rm-accent: var(--rm-d-accent);
    --rm-on-accent: var(--rm-d-onAccent);
    --rm-text: var(--rm-d-text);
    --rm-muted: var(--rm-d-muted);
    --rm-accent-text: var(--rm-d-accentText);
    --rm-border: var(--rm-d-border);
  }
}
/* Wider screens (a centred column), and the narrowest phones. */
@media (min-width: 641px) {
  .rm {
    width: min(100%, 680px);
    margin: auto;
    box-shadow: 0 0 calc(var(--rm-shadow) * 18px)
      color-mix(in srgb, var(--rm-text) 12%, transparent);
  }
  .rm-header {
    padding: 22px 34px 30px;
  }
  .rm-sections {
    padding-left: 26px;
    padding-right: 26px;
  }
  .rm-section {
    padding-left: 34px;
    padding-right: 34px;
  }
  .rm-section.is-feature .rm-items {
    margin-left: -34px;
    margin-right: -34px;
    padding-left: 34px;
    padding-right: 34px;
    scroll-padding-inline: 34px;
  }
  .rm-footer {
    padding-left: 34px;
    padding-right: 34px;
  }
  .rm-item {
    grid-template-columns: minmax(0, 1fr) 150px;
  }
  .rm-photo img {
    width: 150px;
    height: 150px;
  }
  .rm-detail-copy {
    padding-right: 34px;
    padding-left: 34px;
  }
}
@media (max-width: 350px) {
  .rm-header,
  .rm-section,
  .rm-footer {
    padding-left: 14px;
    padding-right: 14px;
  }
  .rm-sections {
    padding-left: 6px;
    padding-right: 6px;
  }
  .rm-item {
    grid-template-columns: minmax(0, 1fr) 92px;
    gap: 13px;
  }
  .rm-photo img {
    width: 92px;
    height: 92px;
  }
  .rm-titleblock h1 {
    font-size: 39px;
  }
  .rm-section h2 {
    font-size: 28px;
  }
  .rm-legend,
  .rm-allergen-sheet {
    grid-template-columns: 1fr;
  }
}
/* Motion: smooth only when the guest has not asked for less; the reduce blocks switch it all off. */
@media (prefers-reduced-motion: no-preference) {
  .rm {
    scroll-behavior: smooth;
  }
}
@media (prefers-reduced-motion: reduce) {
  .rm *,
  .rm *::before,
  .rm *::after {
    scroll-behavior: auto !important;
    animation: none !important;
    transition: none !important;
  }
}
/*
 * The designer's refinements: the whole item is one tap target, the photo sits on a stage panel,
 * names are set in capitals, the dish page is full screen and slides in.
 */
.rm-item {
  position: relative;
}
/* The button sits inside the item's heading and carries its name; its ::before is the item-wide tap
   area, its ::after the arrow (a picture: the second content value is its empty alternative text). */
.rm-item-open {
  text-transform: inherit;
  letter-spacing: inherit;
}
.rm-item-open::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
}
.rm-item-open::after {
  content: "→";
  content: "→" / "";
  display: inline-block;
  margin-left: 8px;
  color: var(--rm-muted);
  font-weight: 500;
  transition: transform 0.2s;
}
.rm-allergens button {
  position: relative;
  z-index: 2;
}
.rm-item:hover .rm-item-open::after {
  transform: translateX(4px);
  color: var(--rm-text);
}
.rm-item:hover .rm-photo img {
  transform: scale(1.02);
}
.rm-photo {
  overflow: hidden;
  border-radius: calc(var(--rm-radius) * 1.2);
}
.rm-photo img {
  transition: transform 0.5s ease;
}
.rm-section:not(.is-feature) .rm-item.has-photo {
  display: block;
  padding: 20px 0 44px;
  border-top: 0;
}
.rm-section:not(.is-feature) .rm-item.has-photo .rm-photo img {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  border-radius: calc(var(--rm-radius) * 1.2);
}
.rm-section:not(.is-feature) .rm-item.has-photo .rm-item-copy {
  padding-top: 18px;
}
.rm-section:not(.is-feature) .rm-item.has-photo :is(h3, h4) {
  font-size: 24px;
  line-height: 1.1;
}
.rm-section:not(.is-feature) .rm-item.has-photo .rm-price {
  font-size: 16px;
}
.rm-section:not(.is-feature) .rm-item.has-photo .rm-description p {
  -webkit-line-clamp: 2;
}
.rm-item.is-text {
  display: block;
  padding: 22px 0;
}
.rm-item.has-photo + .rm-item.is-text {
  border-top: 0;
}
.rm-overlay:has(.is-detail) {
  padding: 0;
  align-items: stretch;
  background: var(--rm-bg);
}
.rm-overlay-panel.is-detail {
  width: min(100%, 680px);
  max-height: none;
  height: 100dvh;
  border-radius: 0;
  box-shadow: none;
  animation: none;
}
.rm-overlay-panel.is-detail > .rm-overlay-head {
  position: fixed;
  top: 14px;
  left: auto;
  right: auto;
  margin-left: 14px;
  width: auto;
}
.rm-detail-copy > p:first-of-type {
  margin-top: 16px;
}
.rm-overlay-panel.is-detail > .rm-overlay-head button {
  margin-left: 0;
  margin-right: auto;
}
.rm-overlay-panel.is-detail .rm-detail-photo img {
  max-height: 62dvh;
  aspect-ratio: 1 / 1;
}
.rm-detail-title h2 {
  font-size: 34px;
}
.rm-detail-copy > p {
  font-size: 16px;
  line-height: 1.6;
}
@media (prefers-reduced-motion: reduce) {
  .rm-photo img,
  .rm-item-open::after {
    transition: none !important;
    transform: none !important;
  }
}
.rm-section:not(.is-feature) .rm-item.has-photo .rm-photo,
.rm-section.is-feature .rm-photo {
  background: var(--rm-surface);
  padding: 14px;
  border-radius: calc(var(--rm-radius) * 1.3);
}
.rm-section:not(.is-feature) .rm-item.has-photo .rm-photo img,
.rm-section.is-feature .rm-photo img {
  border-radius: var(--rm-radius);
  background: transparent;
}
.rm-photo .rm-badges {
  top: 22px;
  left: 22px;
  max-width: calc(100% - 44px);
}
.rm-item-copy > .rm-badges {
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 10px;
}
.rm-badge {
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.rm-item :is(h3, h4),
.rm-detail-title h2 {
  text-transform: uppercase;
  letter-spacing: 0.005em;
}
.rm-labels span {
  border-color: var(--rm-text);
  background: transparent;
}
.rm-item {
  transition:
    transform 0.18s ease,
    opacity 0.2s;
}
.rm-item:active {
  transform: scale(0.985);
}
.rm img {
  animation: rm-fade 0.5s ease both;
}
@keyframes rm-fade {
  from {
    opacity: 0;
  }
}
.rm-sections a:after {
  transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
}
.rm-sections a {
  transition: color 0.2s;
}
.rm-overlay:has(.is-detail) {
  background: color-mix(in srgb, var(--rm-text) 40%, transparent);
  animation: rm-veil 0.32s ease both;
}
.rm-overlay-panel.is-detail {
  animation: rm-sheet 0.38s cubic-bezier(0.16, 1, 0.3, 1) both;
  overflow: auto;
}
.rm-overlay.is-leaving {
  animation: rm-veil-out 0.26s ease forwards;
}
.rm-overlay.is-leaving .rm-overlay-panel {
  animation: rm-sheet-out 0.26s cubic-bezier(0.7, 0, 0.84, 0) forwards;
}
@keyframes rm-sheet {
  from {
    transform: translateY(100%);
  }
}
@keyframes rm-sheet-out {
  to {
    transform: translateY(100%);
  }
}
@keyframes rm-veil {
  from {
    background: transparent;
  }
}
@keyframes rm-veil-out {
  to {
    background: transparent;
  }
}
.rm-overlay-panel.is-detail > .rm-overlay-head {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  margin: 0;
  height: 0;
  min-height: 0;
  padding: 14px 14px 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
}
.rm-overlay-panel.is-detail > .rm-overlay-head button {
  margin: 0;
  background: var(--rm-bg);
  color: var(--rm-text);
  pointer-events: auto;
}
.rm-detail-photo {
  background: var(--rm-surface);
  padding: 72px 28px 28px;
}
.rm-overlay-panel.is-detail .rm-detail-photo img {
  max-height: 56dvh;
  border-radius: var(--rm-radius);
}
.rm-detail-title {
  display: block;
}
.rm-detail-title strong {
  display: block;
  margin-top: 10px;
  font-size: 20px;
}
.rm-detail-allergens {
  font-size: 14px;
  color: var(--rm-muted);
}
.rm-detail-copy {
  padding-bottom: 110px;
}
.rm-detail-bar {
  position: sticky;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  min-height: 64px;
  padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
  background: var(--rm-text);
  color: var(--rm-bg);
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.rm-detail-bar span {
  min-width: 0;
  overflow-wrap: anywhere;
}
.rm-detail-bar strong {
  font-size: 17px;
  white-space: nowrap;
}
@media (prefers-reduced-motion: reduce) {
  .rm-overlay,
  .rm-overlay-panel,
  .rm img,
  .rm-item {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}

/* How the sheets come in. */
@keyframes rm-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: none;
  }
}
.rm-overlay {
  animation: rm-fade 0.24s ease both;
}
.rm-overlay-panel {
  animation: rm-up 0.34s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.rm-item-open:active {
  transform: scale(0.98);
}
@media (prefers-reduced-motion: reduce) {
  .rm-overlay,
  .rm-overlay-panel {
    animation: none !important;
  }
  .rm-item-open:active {
    transform: none;
  }
}
/* The layout switch and the language switch. */
.rm .rm-layout {
  display: inline-flex;
  gap: 2px;
  margin: 14px 20px 0;
  padding: 2px;
  width: auto;
  border: 1px solid var(--rm-border);
  border-radius: var(--rm-pill);
  background: var(--rm-bg);
}
/* Each button is a 44 x 44 px target; the negative margin keeps the row 30 px high, so the capsule
   keeps its height, and the chosen button's fill (its ::before) keeps the 30 px of the old look. */
.rm .rm-layout button {
  position: relative;
  isolation: isolate;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  min-height: 44px;
  margin: -7px 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--rm-muted);
  transition: color 0.18s;
}
.rm .rm-layout button::before {
  content: "";
  position: absolute;
  inset: 7px 0;
  z-index: -1;
  border-radius: calc(var(--rm-pill) - 3px);
  background: transparent;
}
.rm .rm-layout button svg {
  width: 18px;
  height: 18px;
}
.rm .rm-layout button[aria-checked="true"] {
  color: var(--rm-bg);
}
.rm .rm-layout button[aria-checked="true"]::before {
  background: var(--rm-text);
}
.rm .rm-language {
  display: inline-flex;
  margin: 0;
  min-width: 0;
  padding: 3px;
  gap: 2px;
  border: 1px solid color-mix(in srgb, var(--rm-bg) 30%, transparent);
  border-radius: var(--rm-pill);
}
/* The same for the language buttons: 44 x 44 px targets in a 34 px high pill. */
.rm .rm-language button {
  position: relative;
  isolation: isolate;
  min-width: 44px;
  height: 44px;
  min-height: 44px;
  margin: -5px 0;
  padding: 0 8px;
  border: 0;
  background: transparent;
  color: color-mix(in srgb, var(--rm-bg) 70%, transparent);
  font-size: 11.5px;
  font-weight: 850;
  letter-spacing: 0.06em;
}
.rm .rm-language button::before {
  content: "";
  position: absolute;
  inset: 5px 0;
  z-index: -1;
  border-radius: calc(var(--rm-pill) - 3px);
  background: transparent;
}
.rm .rm-language button[aria-pressed="true"] {
  color: var(--rm-text);
}
.rm .rm-language button[aria-pressed="true"]::before {
  background: var(--rm-bg);
}
@media (max-width: 380px) {
  .rm .rm-layout {
    margin-left: 14px;
  }
}
/* Layout: two columns. The photo-led strip is not affected by the layout. */
.rm[data-layout="two"] .rm-section:not(.is-feature) > .rm-items {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 12px;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.is-text {
  grid-column: 1 / -1;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo {
  min-width: 0;
  padding: 14px 0 28px;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-photo {
  padding: 8px;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-photo img {
  aspect-ratio: 4 / 3;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo :is(h3, h4) {
  font-size: 14px;
  line-height: 1.15;
  overflow-wrap: anywhere;
  hyphens: auto;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-item-copy {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 8px;
  padding-top: 12px;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-item-copy > * {
  flex: 1 1 100%;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-item-copy > .rm-price {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-description {
  font-size: 12.5px;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item-open::after {
  display: none;
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-modifiers,
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-extra {
  display: none;
}
@media (max-width: 359px) {
  .rm[data-layout="two"] .rm-section:not(.is-feature) > .rm-items {
    column-gap: 10px;
  }
  .rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo :is(h3, h4) {
    font-size: 12.5px;
  }
  .rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-photo {
    padding: 5px;
  }
}
/* Layout: list (one column of one-line rows with a small photo). One column is the base look. */
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 96px;
  gap: 14px;
  align-items: start;
  position: relative;
  padding: 18px 0;
  border-top: 1px solid var(--rm-border);
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-photo {
  grid-column: 2;
  align-self: start;
  width: 96px;
  height: 96px;
  padding: 0;
  overflow: hidden;
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-photo img {
  width: 96px;
  height: 96px;
  aspect-ratio: 1 / 1;
  object-fit: cover;
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-photo .rm-badges {
  top: 5px;
  left: 5px;
  max-width: 90px;
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-badge {
  font-size: 9px;
  padding: 3px 6px;
  max-width: 90px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-item-copy {
  grid-column: 1;
  grid-row: 1;
  min-width: 0;
  padding-top: 0;
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo :is(h3, h4) {
  font-size: 17px;
}
/* The narrowest phones. The page around the face (no sideways scroll, no scrollbar) is the guest
   page's, not the face's: apps/web styles html[data-guest-page]. */
.rm {
  overflow-x: clip;
  max-width: 100vw;
}
.rm .rm-brandline > :first-child {
  min-width: 0;
}
@media (max-width: 350px) {
  .rm .rm-section.is-feature .rm-items {
    margin: 0 -14px;
    padding: 0 14px 18px;
    scroll-padding-inline: 14px;
  }
  .rm .rm-section.is-feature .rm-item {
    flex-basis: 82vw;
    width: 82vw;
  }
}
@media (min-width: 641px) {
  .rm {
    width: min(100%, 820px);
  }
  .rm-section.is-feature .rm-item {
    flex-basis: 46%;
    width: 46%;
  }
}
/* New in the port: what the page says when the filters leave nothing. */
.rm-empty {
  padding: 64px 20px 0;
  text-align: center;
}
.rm-empty p {
  margin: 0;
  color: var(--rm-muted);
}
.rm-empty .rm-clear {
  margin-top: 8px;
}
@media (min-width: 641px) {
  .rm-empty {
    padding-left: 34px;
    padding-right: 34px;
  }
}

/* Sizes of the compact controls, and the room the bottom bar needs. */
.rm {
  --ro-btn: clamp(32px, 8.6vw, 38px);
  --ro-bar: clamp(46px, 12.4vw, 52px);
  --ro-icon: clamp(16px, 4.4vw, 18px);
}
.rm[data-services="bar"] main {
  padding-bottom: calc(110px + env(safe-area-inset-bottom));
}
.rm[data-services="bar"] .rm-footer {
  padding-bottom: calc(120px + env(safe-area-inset-bottom));
}

/* On a dish card: the "+" and, once the dish is in the bag, the counter. */
.rm .ro-quick {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: flex-end;
  margin-top: -34px;
  pointer-events: none;
}
.rm .ro-quick > * {
  pointer-events: auto;
}
/* The "+" is a real 44 x 44 px button that looks like the designer's round one: the negative margin
   keeps the room it takes (--ro-circle, 32 to 38 px), and the round fill is its ::before. */
.rm .ro-plus {
  --ro-circle: var(--ro-btn);
  position: relative;
  isolation: isolate;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin: calc((var(--ro-circle) - 44px) / 2);
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--rm-bg);
  line-height: 1;
  touch-action: manipulation;
  transition:
    transform 0.18s ease,
    color 0.18s ease;
}
.rm .ro-plus::before {
  content: "";
  position: absolute;
  inset: calc((44px - var(--ro-circle)) / 2);
  z-index: -1;
  border-radius: var(--rm-pill);
  background: var(--rm-text);
  transition:
    background 0.18s ease,
    box-shadow 0.18s ease;
}
.rm .ro-plus svg {
  width: var(--ro-icon);
  height: var(--ro-icon);
  stroke-width: 2.4;
}
.rm .ro-plus:active {
  transform: scale(0.9);
}
.rm .ro-plus-count {
  position: absolute;
  top: calc((44px - var(--ro-circle)) / 2 - 4px);
  right: calc((44px - var(--ro-circle)) / 2 - 4px);
  min-width: 18px;
  height: 18px;
  border-radius: 999px;
  background: var(--rm-accent);
  color: var(--rm-on-accent);
  font-size: 10px;
  font-weight: 850;
  line-height: 18px;
  text-align: center;
}
@media (hover: hover) {
  .rm .ro-plus:hover {
    color: var(--rm-on-accent);
    transform: translateY(-2px);
  }
  .rm .ro-plus:hover::before {
    background: var(--rm-accent);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--rm-text) 22%, transparent);
  }
  .rm .ro-stepper button:hover {
    background: var(--rm-accent);
    color: var(--rm-on-accent);
  }
  .rm .ro-quick .ro-stepper button:hover {
    background: transparent;
  }
  .rm .ro-quick .ro-stepper button:hover::before {
    background: var(--rm-accent);
  }
}
.rm[data-layout="two"] .rm-section:not(.is-feature) .rm-item.has-photo .rm-item-copy > .ro-quick {
  flex: 0 0 auto;
  margin: 0;
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo .ro-quick {
  position: absolute;
  top: calc(18px + 96px - 42px);
  right: 4px;
  z-index: 3;
  margin: 0;
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo .ro-quick .ro-plus {
  --ro-circle: 36px;
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.has-photo .ro-quick .ro-plus::before {
  box-shadow: 0 4px 12px color-mix(in srgb, var(--rm-text) 20%, transparent);
}
.rm[data-layout="list"] .rm-section:not(.is-feature) .rm-item.is-text .ro-quick {
  margin-top: -40px;
}

/* The quantity stepper: 44 px buttons, compact on a dish card (with a 44 px tap area). */
.rm .ro-stepper {
  display: inline-flex;
  align-items: center;
  overflow: hidden;
  border: 1px solid var(--rm-border);
  border-radius: var(--rm-pill);
  background: var(--rm-bg);
  color: var(--rm-text);
}
.rm .ro-stepper button {
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 20px;
  touch-action: manipulation;
}
.rm .ro-stepper button:disabled {
  opacity: 0.3;
  cursor: default;
}
.rm .ro-stepper output {
  min-width: 22px;
  text-align: center;
  font-size: 14px;
  font-weight: 850;
  animation: ro-pop 0.2s ease;
}
/* On a dish card the counter keeps the size the designer drew (buttons of 32 to 38 px) but its buttons
   are real 44 x 44 px targets: the negative margin keeps the room, and the capsule no longer clips
   (its buttons reach a little past it), so the hover fill is drawn by the ::before of each button. */
.rm .ro-quick .ro-stepper {
  overflow: visible;
}
.rm .ro-quick .ro-stepper button {
  position: relative;
  isolation: isolate;
  width: 44px;
  height: 44px;
  min-width: 44px;
  min-height: 44px;
  margin: calc((var(--ro-btn) - 44px) / 2);
  font-size: 16px;
}
.rm .ro-quick .ro-stepper button::before {
  content: "";
  position: absolute;
  inset: calc((44px - var(--ro-btn)) / 2);
  z-index: -1;
  border-radius: var(--rm-pill);
  background: transparent;
}

/* The bill and the pay entry in the venue bar. */
.rm-headtools {
  flex-wrap: wrap;
}
.rm .ro-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 44px;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid color-mix(in srgb, var(--rm-bg) 30%, transparent);
  border-radius: var(--rm-pill);
  background: transparent;
  color: var(--rm-bg);
  font-size: 12.5px;
  font-weight: 800;
  white-space: nowrap;
  transition:
    background 0.18s,
    color 0.18s;
}
.rm .ro-pill svg {
  width: 15px;
  height: 15px;
}
@media (hover: hover) {
  .rm .ro-pill:hover {
    background: var(--rm-bg);
    color: var(--rm-text);
  }
}
@media (max-width: 389px) {
  .rm .ro-billword {
    display: none;
  }
}
/* With the pay entry beside it, the bill keeps to its icon and total up to 440 px too, so the two
   share the venue bar's row instead of the pay entry dropping to a row of its own and pushing the
   title down. The button's name (aria-label) still says "bill". */
@media (max-width: 439px) {
  .rm .ro-pill:has(~ .ro-payentry) .ro-billword {
    display: none;
  }
}
@media (max-width: 380px) {
  .rm .ro-pill {
    gap: 4px;
    padding: 0 9px;
    font-size: 11px;
  }
  .rm-headtools {
    gap: 4px;
  }
}

/* The bar at the bottom: the waiter, and the bag once it has something in it. */
.rm .ro-bagbar {
  position: fixed;
  z-index: 40;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: center;
  gap: 10px;
  padding: 12px max(14px, env(safe-area-inset-right)) calc(12px + env(safe-area-inset-bottom))
    max(14px, env(safe-area-inset-left));
  pointer-events: none;
  animation: ro-up 0.34s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.rm .ro-bagbar button {
  pointer-events: auto;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 10px;
  align-items: center;
  width: min(100%, 560px);
  min-height: max(44px, var(--ro-bar));
  padding: 0 16px 0 6px;
  border: 0;
  border-radius: var(--rm-pill);
  background: var(--rm-text);
  color: var(--rm-bg);
  font-size: 14px;
  font-weight: 850;
  box-shadow: 0 14px 34px color-mix(in srgb, var(--rm-text) 30%, transparent);
  touch-action: manipulation;
  transition: transform 0.12s;
  animation: ro-up 0.34s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.rm .ro-bagbar button:active {
  transform: scale(0.98);
}
.rm .ro-bagbar svg {
  width: var(--ro-icon);
  height: var(--ro-icon);
}
.rm .ro-bagslot {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  max-width: 490px;
}
.rm .ro-bagslot:empty {
  display: none;
}
.rm .ro-bagbar .ro-bagbtn {
  flex: 1 1 auto;
  width: auto;
}
.rm .ro-bagbtn span:nth-child(2) {
  text-align: left;
}
.rm .ro-bagbar .ro-waiter {
  display: flex;
  flex: none;
  justify-content: center;
  gap: 8px;
  width: auto;
  min-width: max(44px, var(--ro-bar));
  padding: 0 16px;
  transition:
    padding 0.3s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.12s;
}
.rm .ro-bagbar[data-bag="true"] .ro-waiter {
  width: max(44px, var(--ro-bar));
  padding: 0;
}
.rm .ro-bagbar[data-bag="true"] .ro-waiter span {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}
.rm .ro-count {
  display: grid;
  place-items: center;
  width: calc(var(--ro-bar) - 14px);
  height: calc(var(--ro-bar) - 14px);
  border-radius: 999px;
  background: var(--rm-accent);
  color: var(--rm-on-accent);
  font-size: 13px;
  animation: ro-pop 0.22s ease;
}

/* The ordering part of the dish page. */
.rm .ro-dish {
  margin-top: 8px;
}
.rm .ro-group {
  margin: 30px 0 0;
  padding: 22px 0 0;
  border: 0;
  border-top: 1px solid var(--rm-border);
}
.rm .ro-group legend {
  display: flex;
  flex-direction: column;
  gap: 3px;
  width: 100%;
  padding: 0;
  margin-bottom: 14px;
}
.rm .ro-group legend > span {
  font-size: 19px;
  font-weight: 850;
}
.rm .ro-group legend small {
  color: var(--rm-muted);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.rm .ro-group.is-invalid legend small {
  color: var(--rm-accent-text);
}
.rm .ro-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
}
.rm .ro-options button,
.rm .ro-choicegrid button,
.rm .ro-tips button,
.rm .ro-scope button {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
  min-height: 58px;
  padding: 10px 14px;
  /* The edge of a choice shows at 3:1: the muted colour reads at 4.5:1 on the page (the border
     colour is for separators and is about 1.3:1). */
  border: 1px solid var(--rm-muted);
  border-radius: var(--rm-radius);
  background: transparent;
  text-align: left;
  font-size: 14px;
  font-weight: 700;
  touch-action: manipulation;
  transition:
    background 0.15s,
    border-color 0.15s,
    color 0.15s;
}
.rm .ro-options [aria-checked="true"],
.rm .ro-options [aria-pressed="true"] {
  border-color: var(--rm-text);
  box-shadow: inset 0 0 0 1px var(--rm-text);
  background: var(--rm-surface);
}
.rm .ro-options b {
  color: var(--rm-muted);
  font-size: 12px;
}
.rm .ro-note {
  display: grid;
  gap: 8px;
  margin-top: 26px;
  font-size: 13px;
  font-weight: 800;
}
.rm .ro-note textarea,
.rm .ro-input input,
.rm .ro-promo input {
  width: 100%;
  min-height: 52px;
  padding: 13px 14px;
  border: 1px solid var(--rm-muted);
  border-radius: var(--rm-radius);
  background: transparent;
  color: inherit;
  font: inherit;
  font-size: 15px;
  resize: vertical;
}
.rm .ro-sheet .ro-note textarea,
.rm .ro-sheet .ro-input input,
.rm .ro-sheet .ro-promo input {
  /* On a sheet (the inverse colours) the edge of an input shows at 3:1 as well: 54 % of the text. */
  border-color: color-mix(in srgb, currentColor 54%, transparent);
}
.rm .ro-dish-bar {
  position: sticky;
  bottom: 0;
  z-index: 2;
  display: flex;
  gap: 10px;
  align-items: center;
  margin: 30px -20px -52px;
  padding: 14px 20px calc(14px + env(safe-area-inset-bottom));
  border-top: 1px solid var(--rm-border);
  background: color-mix(in srgb, var(--rm-bg) 94%, transparent);
  backdrop-filter: blur(12px);
}
.rm .ro-dish-bar .ro-primary {
  padding: 0 16px;
  font-size: 14px;
}

/* Buttons. */
.rm .ro-primary {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  min-height: max(44px, var(--ro-bar));
  padding: 0 20px;
  border: 0;
  border-radius: var(--rm-pill);
  background: var(--rm-accent);
  color: var(--rm-on-accent);
  font-size: 15px;
  font-weight: 850;
  touch-action: manipulation;
  transition:
    transform 0.12s ease,
    opacity 0.15s;
}
.rm .ro-primary[aria-disabled="true"],
.rm .ro-primary:disabled {
  opacity: 0.45;
}
.rm .ro-primary.is-wide {
  width: 100%;
  margin-top: 22px;
}
.rm .ro-primary b {
  animation: ro-pop 0.2s ease;
}
.rm .ro-primary span:only-child {
  margin: auto;
}
.rm .ro-primary:active,
.rm .ro-pay:active {
  transform: scale(0.98);
}
.rm .ro-ghost {
  width: 100%;
  min-height: 50px;
  margin-top: 10px;
  padding: 0 18px;
  border: 1px solid color-mix(in srgb, currentColor 26%, transparent);
  border-radius: 999px;
  background: transparent;
  font-weight: 800;
  touch-action: manipulation;
}
.rm .ro-ghost:disabled {
  opacity: 0.45;
}

/* Sheets: the bag, the bill. */
.rm .ro-preview {
  display: inline-block;
  margin: 14px 0 0;
  padding: 3px 10px;
  border: 1px dashed currentColor;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.rm .ro-sheet {
  padding-top: 6px;
}
.rm .ro-empty {
  padding: 30px 0;
  color: color-mix(in srgb, currentColor 70%, transparent);
}
.rm .ro-lines {
  margin: 0;
  padding: 0;
  list-style: none;
}
.rm .ro-lines li {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 14px;
  padding: 18px 0;
  border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
}
.rm .ro-lines li[data-available="false"] {
  opacity: 0.75;
}
.rm .ro-lines li[data-being-paid],
.rm .ro-lines li[data-paid-in-app] {
  /* A line in some phone's payment, or already paid in the app (D127): greyed, nothing to tick.
     The muted colour keeps its contrast, which a fade of the whole line would not. */
  color: var(--rm-muted);
}
.rm .ro-confirm-note {
  color: var(--rm-muted);
  font-size: 0.9em;
}
.rm .ro-confirm {
  /* The Payment confirmation (D127 1.4): a plain card, nothing of a receipt's look. */
  display: grid;
  gap: 10px;
  padding: 18px;
  border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  border-radius: 12px;
  text-align: left;
}
.rm .ro-confirm p {
  margin: 0;
}
.rm .ro-lines label {
  display: flex;
  gap: 12px;
  align-items: center;
  min-height: 44px;
}
.rm .ro-lines input[type="checkbox"] {
  /* Drawn by us so its edge shows at 3:1 on every theme: 54 % of the text colour, as the inputs'. */
  appearance: none;
  flex: none;
  width: 24px;
  height: 24px;
  margin: 0;
  border: 2px solid color-mix(in srgb, currentColor 54%, transparent);
  border-radius: 6px;
  background: transparent;
}
.rm .ro-lines input[type="checkbox"]:checked {
  border-color: currentColor;
  background: var(--rm-accent);
  box-shadow: inset 0 0 0 3px var(--rm-bg);
}
.rm .ro-line-main {
  display: grid;
  gap: 4px;
  min-width: 0;
}
.rm .ro-line-main strong {
  font-size: 16px;
  overflow-wrap: anywhere;
}
.rm .ro-line-main small {
  color: color-mix(in srgb, currentColor 65%, transparent);
}
.rm .ro-line-main .ro-flag {
  justify-self: start;
  padding: 3px 9px;
  border-radius: 999px;
  background: var(--rm-accent);
  color: var(--rm-on-accent);
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.rm .ro-line-actions {
  display: flex;
  gap: 16px;
}
.rm .ro-line-actions button {
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  border: 0;
  background: transparent;
  font-size: 13px;
  font-weight: 800;
  text-decoration: underline;
  text-underline-offset: 3px;
  touch-action: manipulation;
}
.rm .ro-line-actions button:disabled {
  opacity: 0.45;
}
.rm .ro-line-side {
  display: grid;
  justify-items: end;
  gap: 8px;
}
.rm .ro-sum {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 0 0;
  font-weight: 800;
}
.rm .ro-sum.is-small {
  padding-top: 8px;
  font-size: 14px;
  font-weight: 600;
  opacity: 0.8;
}
.rm .ro-sum.is-big {
  margin-top: 18px;
  border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  font-size: 20px;
}
.rm .ro-notice {
  display: grid;
  gap: 6px;
  margin: 16px 0 0;
  padding: 12px 14px;
  border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
  border-radius: var(--rm-radius);
  font-size: 14px;
}
.rm .ro-notice.is-bad {
  border-color: currentColor;
}
.rm .ro-notice .ro-ghost {
  justify-self: start;
  width: auto;
  margin: 4px 0 0;
}
.rm .ro-notice ul {
  margin: 0;
  padding-left: 18px;
}
/* The last refusal of an order command, over the bar when no sheet is open; a tap dismisses it. */
.rm .ro-barnote {
  position: fixed;
  z-index: 41;
  right: max(14px, env(safe-area-inset-right));
  bottom: calc(max(44px, var(--ro-bar)) + 28px + env(safe-area-inset-bottom));
  left: max(14px, env(safe-area-inset-left));
  box-sizing: border-box;
  max-width: 560px;
  min-height: 44px;
  margin-inline: auto;
  padding: 10px 14px;
  border: 1px solid currentColor;
  border-radius: var(--rm-radius);
  background: var(--rm-bg);
  color: var(--rm-text);
  font-size: 14px;
  text-align: left;
  touch-action: manipulation;
}
/* "Order this from your waiter" on a card, where the POS's ticket takes no choices (#78). */
.rm .ro-quick-note {
  margin: 0;
  padding: 6px 10px;
  border-radius: var(--rm-radius);
  background: var(--rm-bg);
  color: var(--rm-text);
  font-size: 12px;
  font-weight: 700;
}
/* "Show this to your waiter" (D120): the reference in large type, dark on light whatever the theme. */
.rm .ro-waiter-card {
  display: grid;
  gap: 10px;
  margin-top: 18px;
  padding: 18px;
  border-radius: var(--rm-radius);
  color-scheme: light;
  background: Canvas;
  color: CanvasText;
}
.rm .ro-waiter-card p {
  margin: 0;
}
.rm .ro-waiter-card ul {
  margin: 0;
  padding-left: 18px;
}
.rm .ro-waiter-ref {
  font-size: 48px;
  font-weight: 800;
  letter-spacing: 0.08em;
  line-height: 1.1;
}
.rm .ro-sent {
  margin-top: 8px;
}
.rm .ro-round {
  margin-top: 22px;
  padding: 16px;
  border-radius: var(--rm-radius);
  background: color-mix(in srgb, currentColor 7%, transparent);
}
.rm .ro-round header {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-size: 12px;
  font-weight: 850;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.rm .ro-round em {
  padding: 3px 9px;
  border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
  border-radius: 999px;
  font-style: normal;
}
.rm .ro-round[data-source="guest"] em {
  border-color: transparent;
  background: var(--rm-accent);
  color: var(--rm-on-accent);
}
.rm .ro-round ul {
  margin: 10px 0 0;
  padding: 0;
  list-style: none;
}
.rm .ro-round li {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto auto;
  gap: 10px;
  align-items: center;
  padding: 10px 0;
  font-size: 14px;
}
.rm .ro-round li[data-status="cancelled"] .ro-tabname {
  text-decoration: line-through;
}
.rm .ro-tabname {
  display: grid;
  overflow-wrap: anywhere;
}
.rm .ro-tabname small {
  opacity: 0.65;
}
.rm .ro-qty {
  font-weight: 850;
}
.rm .ro-status {
  padding: 4px 8px;
  border-radius: 999px;
  background: color-mix(in srgb, currentColor 12%, transparent);
  font-size: 11px;
  font-weight: 850;
}
.rm .ro-status[data-status="preparing"] {
  background: var(--rm-accent);
  color: var(--rm-on-accent);
}
/* A line that is done is quieter: an outline instead of a tint. (It used to fade to 60 %, which
   left its small text at about 3.5:1.) */
.rm .ro-status[data-status="served"],
.rm .ro-status[data-status="cancelled"] {
  background: transparent;
  box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 40%, transparent);
}

/* The waiter sheet, and the states a service goes through. */
.rm .ro-choicegrid,
.rm .ro-tips {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  margin-top: 14px;
}
.rm .ro-choicegrid button,
.rm .ro-tips button,
.rm .ro-scope button {
  /* On a sheet (the inverse colours) a choice's edge is 54 % of the text colour, which shows at
     3:1 on every theme checked (it was 24 %, about 1.7:1). */
  border-color: color-mix(in srgb, currentColor 54%, transparent);
}
.rm .ro-choicegrid button {
  display: flex;
  align-items: center;
  gap: 10px;
}
.rm .ro-choicegrid button svg {
  width: 20px;
  height: 20px;
  flex: none;
}
.rm .ro-choicegrid [aria-checked="true"],
.rm .ro-tips [aria-checked="true"],
.rm .ro-tips [aria-pressed="true"],
.rm .ro-sheet .ro-ghost[aria-pressed="true"],
.rm .ro-scope [aria-checked="true"] {
  /* The chosen one: the accent fill, and a ring in the sheet's own text colour, so it stands out by
     more than hue (the accent can be as light as the sheet itself: 1.06:1 on Botanical dark). */
  border-color: var(--rm-bg);
  background: var(--rm-accent);
  color: var(--rm-on-accent);
  box-shadow: inset 0 0 0 1px var(--rm-bg);
}
.rm .ro-state {
  display: grid;
  justify-items: center;
  gap: 8px;
  padding: 40px 0 10px;
  text-align: center;
}
.rm .ro-state h3 {
  margin: 12px 0 0;
  font-size: 22px;
}
.rm .ro-state p {
  max-width: 32ch;
  margin: 0;
  opacity: 0.75;
}
.rm .ro-state .ro-kind {
  font-weight: 800;
  opacity: 0.9;
}
.rm .ro-state .ro-primary,
.rm .ro-state .ro-ghost {
  max-width: 340px;
}
.rm .ro-spinner {
  width: 54px;
  height: 54px;
  border: 3px solid color-mix(in srgb, currentColor 18%, transparent);
  border-top-color: var(--rm-accent);
  border-radius: 999px;
  animation: ro-spin 0.8s linear infinite;
}
.rm .ro-check {
  display: grid;
  place-items: center;
  width: 64px;
  height: 64px;
  border-radius: 999px;
  background: var(--rm-accent);
  color: var(--rm-on-accent);
  font-size: 30px;
  font-weight: 900;
  animation: ro-pop 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}
.rm .ro-check.is-bad {
  border: 2px solid currentColor;
  background: transparent;
  color: inherit;
}
.rm .ro-pulse {
  width: 20px;
  height: 20px;
  border-radius: 999px;
  background: var(--rm-accent);
  animation: ro-pulse 1.4s ease-out infinite;
}

/* The pay sheet. */
.rm .ro-scope {
  display: grid;
  gap: 8px;
}
.rm .ro-tips {
  grid-template-columns: repeat(auto-fit, minmax(72px, 1fr));
  gap: 6px;
}
.rm .ro-tips button {
  grid-template-columns: 1fr;
  min-height: 48px;
  padding: 0 4px;
  text-align: center;
  font-size: 13px;
}
.rm .ro-h {
  margin: 26px 0 10px;
  font-size: 15px;
  font-weight: 850;
}
.rm .ro-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
}
.rm .ro-row .ro-stepper {
  border-color: color-mix(in srgb, currentColor 24%, transparent);
  background: transparent;
  color: inherit;
}
.rm .ro-input {
  display: block;
  margin-top: 10px;
}
.rm .ro-acc {
  margin-top: 22px;
  border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent);
}
.rm .ro-acc summary {
  display: flex;
  align-items: center;
  min-height: 52px;
  font-weight: 800;
  cursor: pointer;
}
.rm .ro-promo {
  display: flex;
  gap: 8px;
  padding-bottom: 14px;
}
.rm .ro-promo .ro-ghost {
  width: auto;
  margin: 0;
}
.rm .ro-allergy {
  font-size: 13px;
  opacity: 0.75;
}
/* The legal block's two controls (ticket 198): the Privacy link and the "About the venue" disclosure keep
   the hint's look but are 44 px to tap. */
.rm .ro-allergy a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
}
.rm .ro-allergy summary {
  box-sizing: border-box;
  min-height: 44px;
  padding-block: 12px;
  cursor: pointer;
}
.rm .ro-methods {
  display: grid;
  gap: 9px;
  margin-top: 20px;
}
.rm .ro-pay {
  min-height: 54px;
  border: 1px solid color-mix(in srgb, currentColor 26%, transparent);
  border-radius: var(--rm-pill);
  background: var(--rm-bg);
  color: var(--rm-text);
  font-weight: 850;
  touch-action: manipulation;
}
.rm .ro-pay.is-apple {
  border-color: transparent;
  background: var(--rm-accent);
  color: var(--rm-on-accent);
}
.rm .ro-pay:disabled {
  opacity: 0.45;
}

/* The receipt page. */
.rm .ro-page {
  padding: 76px 20px 40px;
}
.rm .ro-page > h2 {
  margin: 0 0 6px;
  font-size: 30px;
  font-weight: 880;
  letter-spacing: -0.01em;
  text-transform: uppercase;
}
.rm .ro-page .ro-preview {
  margin: 0 0 8px;
}
.rm .ro-receipt {
  margin-top: 10px;
  padding: 22px 20px;
  border-radius: var(--rm-radius);
  background: var(--rm-bg);
  color: var(--rm-text);
  font-size: 14px;
}
.rm .ro-page .ro-receipt {
  background: var(--rm-surface);
  box-shadow: 0 1px 0 var(--rm-border);
}
.rm .ro-receipt header {
  display: grid;
  gap: 3px;
  justify-items: center;
  padding-bottom: 16px;
  border-bottom: 1px dashed var(--rm-border);
  text-align: center;
}
.rm .ro-receipt header strong {
  font-size: 18px;
  letter-spacing: 0.12em;
  overflow-wrap: anywhere;
}
.rm .ro-receipt header span {
  color: var(--rm-muted);
  font-size: 12px;
}
.rm .ro-receipt ul {
  margin: 0;
  padding: 12px 0;
  border-bottom: 1px dashed var(--rm-border);
  list-style: none;
}
.rm .ro-receipt li,
.rm .ro-receipt dl div {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 5px 0;
}
.rm .ro-receipt dl {
  margin: 12px 0 0;
}
.rm .ro-receipt dd {
  margin: 0;
  font-weight: 700;
}
.rm .ro-receipt .is-total {
  margin: 6px 0;
  padding: 10px 0;
  border-top: 1px solid var(--rm-border);
  border-bottom: 1px solid var(--rm-border);
  font-size: 18px;
  font-weight: 900;
}
.rm .ro-ref {
  margin: 12px 0 0;
  color: var(--rm-muted);
  font-size: 12px;
  text-align: center;
}
.rm .ro-toast {
  margin-top: 14px;
  text-align: center;
  font-weight: 800;
  animation: ro-fade 0.2s;
}

/* Wider screens match the dish page's wider padding. */
@media (min-width: 641px) {
  .rm .ro-dish-bar {
    margin-right: -34px;
    margin-left: -34px;
    padding-right: 34px;
    padding-left: 34px;
  }
  .rm .ro-page {
    padding-right: 34px;
    padding-left: 34px;
  }
}

/* Motion. */
@keyframes ro-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: none;
  }
}
@keyframes ro-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
@keyframes ro-pop {
  0% {
    transform: scale(0.7);
    opacity: 0.3;
  }
  100% {
    transform: none;
    opacity: 1;
  }
}
@keyframes ro-spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes ro-pulse {
  0% {
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--rm-accent) 60%, transparent);
  }
  100% {
    box-shadow: 0 0 0 22px transparent;
  }
}
@media (prefers-reduced-motion: reduce) {
  .rm .ro-bagbar,
  .rm .ro-bagbar button,
  .rm .ro-count,
  .rm .ro-stepper output,
  .rm .ro-primary b,
  .rm .ro-check,
  .rm .ro-spinner,
  .rm .ro-pulse,
  .rm .ro-toast {
    animation: none !important;
  }
  .rm .ro-primary:active,
  .rm .ro-pay:active,
  .rm .ro-plus:active,
  .rm .ro-bagbar button:active {
    transform: none;
  }
}
