# Copy to .env.local and fill in. .env.local is never committed (see .gitignore).
# This file holds placeholders only: no real value ever goes here.
# The database, barsy, sealing, worker and web-app variables below are in use today. The ones
# left commented out (webhook secrets, Turnstile, Cloudflare R2, email,
# Sentry, Telegram) are NOT used yet; each is listed so the later task that needs it has a home
# for it (what each is for follows docs/architecture/stack.md; the variable names are
# provisional and the task that first uses one may rename it).

# --- Database --------------------------------------------------------------------------------
# Local Postgres 17 started by `pnpm db:local` (localhost only). After `pnpm db:migrate` and
# `pnpm db:roles` (both read the variables below from your shell; nothing reads this file
# automatically). See docs/runbooks/supabase-setup.md for staging.
#
# Web app and worker: the role restro_app, which cannot bypass row-level security. Its password
# must equal DATABASE_APP_PASSWORD. The app refuses to run as a superuser or the table owner.
# `pnpm db:roles` also sets the role's session defaults (statement_timeout = 30s,
# idle_in_transaction_session_timeout = 60s), so no connection string needs to carry them.
DATABASE_URL=postgres://restro_app:local-only-not-a-secret@localhost:54329/restro
# Migration owner: only `pnpm db:migrate`, `pnpm db:roles` and the integration tests use it.
# Never give it to the web app or the worker. Locally it is the db:local superuser.
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:54329/restro
# The password `pnpm db:roles` sets for restro_app: 16+ printable ASCII characters, no spaces.
DATABASE_APP_PASSWORD=local-only-not-a-secret
# The purge role restro_purge (D83): the only role with DELETE on venue data, used by the
# worker's purge job alone. `pnpm db:roles` creates it with this password; DATABASE_URL_PURGE
# (worker only) must carry the same one. Without DATABASE_URL_PURGE the worker registers no
# purge job.
DATABASE_PURGE_PASSWORD=local-only-purge-not-a-secret
DATABASE_URL_PURGE=postgres://restro_purge:local-only-purge-not-a-secret@localhost:54329/restro
# The db scripts refuse any non-local database unless this is 1. Only the deploy pipeline or
# the runner named in docs/runbooks/supabase-setup.md sets it; never set it on a laptop.
# RESTRO_DB_ALLOW_REMOTE=

# --- barsy (worker only; `pnpm barsy:record` loads these from .env.local) -------------------
# One API user per integration per environment (CLAUDE.md rule 9). Staging must never hold
# production hosts: outside production only the demo host and BARSY_ALLOWED_HOSTS are accepted.
# Host of the barsy installation, with or without https://. The public demo installation is
# demo.barsyonline.com (user "demo"; its password comes from the form at https://www.barsy.bg/demo/).
BARSY_HOST=demo.barsyonline.com
# The API user's name and password. Never commit them, never paste them in chat.
BARSY_USER=
BARSY_PASSWORD=
# Which environment this configuration belongs to: development | test | staging | production
BARSY_ENV=development
# Comma-separated hosts this environment may talk to (for example a pilot venue's installation).
# Outside production the demo host is always accepted; production accepts only what is listed
# here, the demo host included.
# BARSY_ALLOWED_HOSTS=

# --- Sealed barsy credentials (D55) ---------------------------------------------------------
# The web app seals the barsy credentials a manager enters with the worker's PUBLIC key; only
# the worker, holding the PRIVATE key, can open them. Generate a pair with
#   pnpm keys:seal --write-env <file>
# which appends both lines to that file and prints only the public key (never the private key).
# The web app loads the root .env.local, so a worker-only file (e.g. .env.worker.local, git-
# ignored like every .env.*) keeps the private key out of the web process; then copy only the
# SEAL_PUBLIC_KEY line into .env.local.
# Each value is one line of base64url DER (public: SPKI, private: PKCS8, X25519). One pair per
# environment; a new pair means every integration must be connected again ("sealed for another
# key"). Leave both empty here: never put a real key in this file.
# Web app and worker:
SEAL_PUBLIC_KEY=
# Worker ONLY. Never give it to the web app (it never declares this variable). The worker needs
# both keys to run barsy sync jobs; without them it still starts.
SEAL_PRIVATE_KEY=

# --- Worker (apps/worker; README, "The worker") --------------------------------------------
# The worker also needs DATABASE_URL (above): the restro_app role, never the owner. These three
# are optional; the values shown are the defaults.
# Name of this process in restro.worker_heartbeats. Default: the host name.
# WORKER_ID=
# Port of GET /health, which Railway probes. 1 to 65535.
WORKER_HEALTH_PORT=8081
# fatal | error | warn | info | debug | trace | silent
# Logs are readable lines unless NODE_ENV=production, which switches them to JSON.
LOG_LEVEL=info
# `pnpm --filter @restro/worker dev` loads the root .env.local and then .env.worker.local (each only
# if it exists; both are git-ignored). Put the worker-only SEAL_PRIVATE_KEY in .env.worker.local so
# that the web app, which loads .env.local, never sees it. Without both SEAL_ keys the worker still
# starts, runs the heartbeat and registers no barsy sync job (one warning in the log).
#
# Which barsy hosts the sync jobs may talk to (CLAUDE.md rule 9). An integration's host comes from
# the database, typed by a manager, so the worker checks it before it opens the credentials:
# - it must end with one of BARSY_ALLOWED_HOST_SUFFIXES (default .barsyonline.com);
# - every environment but production refuses the hosts in BARSY_PRODUCTION_HOSTS, so a staging
#   worker can never read a live venue's till.
# BARSY_ENV (above) is the environment the worker belongs to; the worker reads it too.
# BARSY_ALLOWED_HOST_SUFFIXES=.barsyonline.com
# BARSY_PRODUCTION_HOSTS=
# Barsy photos go to the asset store (ASSET_STORE and R2_*, further down), the same one the web
# app reads. The worker only writes there.

# --- Web app -------------------------------------------------------------------------------
# Better Auth (venue-admin login). `pnpm dev` and `pnpm build` read this file through
# apps/web/next.config.ts. The secret signs session cookies: 32+ characters; in staging and
# production generate a real one (`openssl rand -base64 32`) and never reuse this value.
BETTER_AUTH_SECRET=local-only-not-a-secret-0123456789abcdef
# The public address of the app (cookies and the origin check use it).
BETTER_AUTH_URL=http://localhost:3000
# The address the table QR codes are printed with by default: `<this>/t/<token>` (brief S3-07, D61).
# A venue can save another one in Tables & QR. Unset means BETTER_AUTH_URL above. While building,
# use this PC's network address (for example http://192.168.1.20:3000) to scan from a phone on the
# same Wi-Fi; later the permanent domain (P53). Plain http is accepted only for this PC and the
# local network.
# PUBLIC_BASE_URL=
# `pnpm db:seed:dev` creates the demo owner of "Demo Club" from these two. It refuses to run
# unless NODE_ENV is development and DATABASE_URL points at this machine. Local values only.
DEV_ADMIN_EMAIL=owner@demo-club.test
DEV_ADMIN_PASSWORD=local-only-not-a-secret
# Later: AES-256-GCM key for webhook secrets. Web app environment only.
# WEBHOOK_SECRETS_KEY=
# Later: Cloudflare Turnstile bot checks.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Storage and delivery (Cloudflare R2: snapshots, images, backups) ----------------------
# Item photos (apps/web/src/server/assets): `local` writes files under .local/assets (or
# LOCAL_ASSET_DIR) and serves them through a signed, authenticated route; `r2` uses the private
# bucket below with presigned GET links. Unset means local in development and an error in
# production. The R2 values are not needed to run or test anything locally.
ASSET_STORE=local
# LOCAL_ASSET_DIR=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (EU jurisdiction: ...<id>.eu.r2...).
# R2_ENDPOINT=

# Published menus and photo variants (brief S3-01b): the files a guest page reads (`snap/…`, `m/…`,
# `a/…`). Public by design; the worker writes them, never an original photo. `local` writes under
# .local/cdn (or LOCAL_PUBLISH_DIR) and the web app serves them at /cdn/…; `r2` puts them in the
# public bucket behind the CDN (the account and key are the asset store's R2_* above). Unset means
# local in development and an error in production.
PUBLISH_STORE=local
# LOCAL_PUBLISH_DIR=
# R2_PUBLIC_BUCKET=
# Where the guest page (/m/<venue>, /t/<token>) reads published files and photos from. Unset means
# this app's own /cdn route (the local publish store). With PUBLISH_STORE=r2 set the CDN's address,
# absolute (the /t route reads token files from it on the server): https://cdn.example.com. It is
# inlined at build time, so set it before `pnpm build`.
# NEXT_PUBLIC_CDN_BASE_URL=
# After `pnpm install`, make the photo variants of photos stored before they existed (safe to repeat):
#   pnpm --filter @restro/worker variants:backfill

# --- Email, monitoring, alerts --------------------------------------------------------------
# RESEND_API_KEY=
# SENTRY_DSN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
