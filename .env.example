# Copy to .env.local and fill in. .env.local is never committed (see .gitignore).
# This file holds placeholders only: no real value ever goes here.
# The secrets below are NOT used yet; each is listed so the later task that needs it has a home
# for it (what each is for follows docs/architecture/stack.md; the variable names are
# provisional and the task that first uses one may rename it).

# --- Database (used by the app and the worker) ---------------------------------------------
# Local Postgres 17 started by `pnpm db:local` (superuser postgres/postgres, localhost only).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/restro
# Later: the app connects with a role that cannot bypass row-level security, and migrations
# run as a separate owner role. Local development may point both at the superuser above.
# DATABASE_MIGRATION_URL=

# --- barsy (worker only; `pnpm barsy:record` reads these from .env.local) ------------------
# One API user per integration per environment. Staging must never hold production hosts.
# BARSY_BASE_URL=
# BARSY_API_USER=
# BARSY_API_PASSWORD=
# Later: AES-256-GCM key that encrypts stored barsy credentials. Worker environment only.
# BARSY_CREDENTIALS_KEY=

# --- Web app -------------------------------------------------------------------------------
# Later: Better Auth (venue-admin login).
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# Later: AES-256-GCM key for webhook secrets. Web app environment only.
# WEBHOOK_SECRETS_KEY=
# Later: Cloudflare Turnstile bot checks.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Storage and delivery (Cloudflare R2: snapshots, images, backups) ----------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Email, monitoring, alerts --------------------------------------------------------------
# RESEND_API_KEY=
# SENTRY_DSN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
